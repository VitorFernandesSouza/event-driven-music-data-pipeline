# Datasets added manually to the Bronze layer are kept out of future commits.
data/bronze/*

# Python and environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Environment, credentials, and secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials*
aws-credentials*

# IDE and operating system
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Generated, temporary, and logs
logs/
*.log
*.tmp
*.temp
*.parquet
*.json
*.zip

